{
  "name": "thecueroom",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "bootstrap": "pnpm install && pnpm -r run build:types || true",
    "typecheck": "pnpm -r --filter=!@thecueroom/mobile --filter=!functions --filter=!web exec tsc -b",
    "lint": "pnpm -r exec eslint .",
    "format": "pnpm -r exec prettier -w .",
    "test": "pnpm -r --filter=!@thecueroom/mobile test --if-present",
    "analyze": "pnpm -r --filter \"./apps/*\" run analyze",
    "depcheck": "pnpm -r exec depcheck --ignores=@types/*,eslint*,prettier*",
    "unused": "node scripts/find-unused.js",
    "ci": "pnpm bootstrap && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "pnpm --filter ./apps/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter ./apps/web run start",
    "ci:install": "pnpm install --frozen-lockfile",
    "ci:lint": "pnpm -r run lint",
    "ci:typecheck": "pnpm -r run typecheck",
    "ci:test": "pnpm -r run test",
    "ci:build": "pnpm -r run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "depcheck": "^1.4.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ]
}
