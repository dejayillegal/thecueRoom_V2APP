{
  "name": "thecueroom",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "audit": "node scripts/repo-audit.mjs",
    "s": "npm run audit",
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web && npm run typecheck --prefix apps/mobile",
    "lint": "npm run lint --prefix apps/web && npm run lint --prefix apps/mobile",
    "lint:fix": "npm run lint:fix --prefix apps/web && npm run lint:fix --prefix apps/mobile",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test --prefix apps/web && npm run test --prefix apps/mobile",
    "test:e2e": "npm run test:e2e --prefix apps/web",
    "test:mobile": "npm run test --prefix apps/mobile",
    "test:a11y": "node scripts/run-axe-smoke.cjs",
    "verify-logo": "node scripts/verify-logo.mjs verify",
    "protect-logo": "node scripts/protect-logo.mjs restore",
    "no-placeholders": "node scripts/no-placeholders.mjs",
    "security-audit": "npm audit --audit-level=high",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "reset": "npm run clean && npm install",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run security-audit && npm run verify-logo"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.54.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "dependencies": {
    "@types/jest": "^30.0.0"
  }
}